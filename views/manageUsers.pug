extends base

block content
  .admin.container
    if alert
      .alert.alert--success #{alert}

    h2.heading-secondary.ma-bt-md
      | #{type === 'guides' ? 'Manage Guides & Lead-Guides' : 'Manage Users'}

    // Toggle view buttons
    if type === 'guides'
      a.btn.btn--small.btn--green(href='/manage-users/list?type=users') View All Users
    else
      a.btn.btn--small.btn--green(href='/manage-users/list?type=guides') View Guides & Lead-Guides

    if users.length
      table.table
        thead
          tr
            th Photo
            th Name
            th Email
            th Role
            if type === 'guides'
              th Actions
        tbody
          each user in users
            tr
              td
                img(src=`/img/users/${user.photo}`, alt='User Photo', class='user-img')
              td #{user.name}
              td #{user.email}
              td #{user.role}
              if type === 'guides'
                td
                  form(method="POST", action=`/api/v1/users/${user._id}?_method=DELETE`)
                    button.btn.btn--small.btn--red(
                      type="submit",
                      onclick="return confirm('Are you sure you want to delete this guide?');"
                    ) Delete
    else
      p No #{type} found.

    if totalPages > 1
      .pagination
        if currentPage > 1
          a.pagination__btn.pagination__btn--prev(href=`/manage-users/list?type=${type}&page=${currentPage - 1}`) &larr; Prev
        span.page-number Page #{currentPage} of #{totalPages}
        if currentPage < totalPages
          a.pagination__btn.pagination__btn--next(href=`/manage-users/list?type=${type}&page=${currentPage + 1}`) Next &rarr;

  style.
    .user-img {
      width: 40px;
      border-radius: 50%;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    .table th, .table td {
      padding: 12px;
      border: 1px solid #ddd;
      text-align: left;
    }
    .pagination {
      display: flex;
      justify-content: center;
      margin-top: 20px;
      align-items: center;
      gap: 12px;
    }
    .pagination__btn {
      padding: 8px 16px;
      background-color: #55c57a;
      color: white;
      border-radius: 5px;
      text-decoration: none;
    }
    .pagination__btn--prev {
      background-color: #f44336;
    }
    .alert {
      padding: 12px 20px;
      margin-bottom: 20px;
      border-radius: 5px;
    }
    .alert--success {
      background-color: #55c57a;
      color: white;
    }
    .btn--green {
      margin-bottom: 20px;
      display: inline-block;
    }
