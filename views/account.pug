extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings')
          +navItem('/my-tours', 'My bookings', 'briefcase')
          +navItem('/my-reviews', 'My reviews', 'star')
          +navItem('/billing', 'Billing', 'credit-card')

          if user.role === 'admin'
            .admin-nav
              h5.admin-nav__heading Admin
              ul.side-nav
                +navItem('/manage-tours', 'Manage tours', 'map')
                +navItem('/manage-users', 'Manage users', 'users')
                +navItem('/manage-reviews', 'Manage reviews', 'star')
                +navItem('/manage-bookings', 'Manage bookings', 'briefcase')
                +navItem('/admin/accessibility-requests', 'Manage accessibility', 'briefcase')

      .user-view__content
        .user-view__form-container
          h2.heading-secondary.ma-bt-md Your account settings

          form.form.form-user-data(method="POST" action="/submit-user-data")
            .form__group
              label.form__label(for='name') Name
              input#name.form__input(type='text', name='name', value=user.name, required)
            .form__group.ma-bt-md
              label.form__label(for='email') Email address
              input#email.form__input(type='email', name='email', value=user.email, required)
            .form__group.form__photo-upload
              img.form__user-photo(src=`/img/users/${user.photo}`, alt='User photo')
              input.form__upload(type='file', accept='image/*', id='photo', name='photo')
              label(for='photo') Choose new photo
            .form__group.right
              button.btn.btn--small.btn--green Save settings

        .line &nbsp;

        .user-view__form-container
          h2.heading-secondary.ma-bt-md Password change

          form.form.form-user-password
            .form__group
              label.form__label(for='password-current') Current password
              input#password-current.form__input(type='password', placeholder='••••••••', required)
            .form__group
              label.form__label(for='password') New password
              input#password.form__input(type='password', placeholder='••••••••', required)
            .form__group.ma-bt-lg
              label.form__label(for='password-confirm') Confirm password
              input#password-confirm.form__input(type='password', placeholder='••••••••', required)
            .form__group.right
              button.btn.btn--small.btn--green.btn--save-password Save password

        if user.role === 'admin'
          .line &nbsp;

          .user-view__form-container
            h2.heading-secondary.ma-bt-md Create New Guide / Lead Guide

            form.form(method="POST", action="/admin/create-user")
              .form__group
                label.form__label(for='newName') Name
                input#newName.form__input(type='text', name='name', required)
              .form__group
                label.form__label(for='newEmail') Email
                input#newEmail.form__input(type='email', name='email', required)
              .form__group
                label.form__label(for='newPassword') Password
                input#newPassword.form__input(type='password', name='password', minlength='8', required)
              .form__group
                label.form__label(for='newPasswordConfirm') Confirm Password
                input#newPasswordConfirm.form__input(type='password', name='passwordConfirm', minlength='8', required)
              .form__group
                label.form__label(for='role') Role
                select#role.form__input(name='role', required)
                  option(value='' disabled selected) -- Select Role --
                  option(value='guide') Guide
                  option(value='lead-guide') Lead Guide
              .form__group.right
                button.btn.btn--small.btn--green Create User
