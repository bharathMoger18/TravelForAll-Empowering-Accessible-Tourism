extends base

block content
  main.main
    .card-container
      if tours.length
        each tour in tours
          .card
            .card__header
              .card__picture
                .card__picture-overlay &nbsp;

                - const imgSrc = tour.imageCover && tour.imageCover.startsWith('http') ? tour.imageCover : `/img/tours/${tour.imageCover || 'default.jpg'}`

                img.card__picture-img(
                  src=imgSrc,
                  alt=tour.name,
                  onerror="this.onerror=null;this.src='/img/tours/default.jpg';"
                )

              h3.heading-tertirary
                span= tour.name

            .card__details
              h4.card__sub-heading= `${tour.difficulty} ${tour.duration}-day tour`
              p.card__text= tour.summary

              .card__data
                svg.card__icon
                  use(xlink:href='/img/icons.svg#icon-map-pin')
                if tour.startLocation && tour.startLocation.description
                  span= tour.startLocation.description
                else
                  span No location

              .card__data
                svg.card__icon
                  use(xlink:href='/img/icons.svg#icon-calendar')
                - const date = tour.startDates && tour.startDates.length ? new Date(tour.startDates[0]).toLocaleString('en-us', { month: 'long', year: 'numeric' }) : 'Not scheduled'
                span= date

              .card__data
                svg.card__icon
                  use(xlink:href='/img/icons.svg#icon-flag')
                span= `${(tour.locations && tour.locations.length) || 0} stops`

              .card__data
                svg.card__icon
                  use(xlink:href='/img/icons.svg#icon-user')
                span= `${tour.maxGroupSize || 0} people`

              .card__data
                svg.card__icon
                  use(xlink:href='/img/icons.svg#icon-users')
                if typeof tour.remainingSeats === 'number'
                  if tour.remainingSeats === 0
                    span(style='color: red') Sold out!
                  else if tour.remainingSeats < 5
                    span(style='color: orange')= `${tour.remainingSeats} seats left`
                  else
                    span= `${tour.remainingSeats} seats left`
                else
                  span Unknown availability

            .card__footer
              p
                span.card__footer-value= `$${tour.price}`
                |
                span.card__footer-text per person

              p.card__ratings
                span.card__footer-value= tour.ratingsAverage || '4.5'
                |
                span.card__footer-text= `rating (${tour.ratingsQuantity || 0})`

              a.btn.btn--green.btn--small(href=`/tour/${tour.slug}`) Details
      else
        p.text-center No tours available. Create one now!
